from datetime import datetime

from fastapi import HTTPException, status
from sqlalchemy.orm import Session

from app.models import User, WorkRecord
from app.schemas import UserCreate, WorkRecordCreate
from app.security import hash_password


def get_user_by_email(db: Session, email: str):
    return db.query(User).filter(User.email == email.lower()).first()


def create_user(db: Session, user_data: UserCreate) -> User:
    user = User(
        full_name=user_data.full_name.strip(),
        email=user_data.email.lower(),
        hashed_password=hash_password(user_data.password),
        created_at=datetime.utcnow(),
    )
    db.add(user)
    db.commit()
    db.refresh(user)
    return user


def create_work_record(db: Session, user_id: int, record_data: WorkRecordCreate) -> WorkRecord:
    record = WorkRecord(
        user_id=user_id,
        record_date=record_data.record_date,
        customer_name=record_data.customer_name.strip(),
        work_content=record_data.work_content.strip(),
        work_type=record_data.work_type.strip() or "一般",
        status=record_data.status.strip() or "未対応",
        duration_minutes=record_data.duration_minutes,
        note=record_data.note.strip(),
        created_at=datetime.utcnow(),
    )
    db.add(record)
    db.commit()
    db.refresh(record)
    return record


def get_user_work_records(
    db: Session,
    user_id: int,
    customer_name: str | None = None,
    start_date: datetime | None = None,
    end_date: datetime | None = None,
    status: str | None = None,
):
    query = db.query(WorkRecord).filter(WorkRecord.user_id == user_id)

    if customer_name:
        query = query.filter(WorkRecord.customer_name.ilike(f"%{customer_name}%"))
    if start_date:
        query = query.filter(WorkRecord.record_date >= start_date)
    if end_date:
        query = query.filter(WorkRecord.record_date <= end_date)
    if status:
        query = query.filter(WorkRecord.status == status)

    return query.order_by(WorkRecord.record_date.desc()).all()


def get_work_record_by_id(db: Session, work_record_id: int, user_id: int):
    record = db.query(WorkRecord).filter(WorkRecord.id == work_record_id, WorkRecord.user_id == user_id).first()
    if not record:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="業務記録が見つかりません")
    return record


def delete_work_record(db: Session, work_record_id: int, user_id: int) -> None:
    record = get_work_record_by_id(db, work_record_id, user_id)
    db.delete(record)
    db.commit()
